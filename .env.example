# ============================================================
# AI Travel Concierge — environment variable reference
# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.
# To add a new env var: add it here, then add it to the
# relevant app's src/lib/env.ts schema. See spec §28.
# ============================================================

# --- Runtime ---
NODE_ENV=development

# --- Git (set automatically by CI; optional locally) ---
GIT_COMMIT_SHA=

# --- Platform domain ---
PLATFORM_PRIMARY_DOMAIN=ai-travelconcierge.com
# Regex matching subdomains; capture group 1 must be the slug.
PLATFORM_DOMAIN_REGEX=^([a-z0-9-]+)\.ai-travelconcierge\.com$

# --- Supabase (main app) — added in Build Prompt 02 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (RAG service — separate project) — added in Build Prompt 06 ---
# RAG_SUPABASE_URL=
# RAG_SUPABASE_ANON_KEY=
# RAG_SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe — added in Build Prompt 07 ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Anthropic — added when AI features land ---
# ANTHROPIC_API_KEY=

# --- OpenAI (embeddings) — added in Build Prompt 06 ---
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Inngest — added in Build Prompt 07 ---
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# --- Resend — added when email features land ---
# RESEND_API_KEY=

# --- §26.6 Operator alerting (sendOperatorAlert) ---
# Recipient inbox for monitoring alerts. When set, sendOperatorAlert
# delivers via Resend; when unset, alerts still land in audit_log +
# console.warn (visible in Vercel runtime logs).
# OPERATOR_ALERT_EMAIL=
