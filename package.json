{
  "name": "atc-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "test:cross-tenant": "vitest run tests/security/cross-tenant-probe",
    "test:error-injection": "vitest run apps/main/test/error-injection && pnpm --dir apps/rag exec vitest run test/error-injection",
    "test:contracts": "vitest run tests/contracts",
    "contracts:record": "tsx scripts/record-contracts.ts",
    "rls:snapshot:main": "tsx scripts/rls-snapshot.ts --target=main > db/rls-snapshot-main.sql",
    "rls:snapshot:rag": "tsx scripts/rls-snapshot.ts --target=rag > db/rls-snapshot-rag.sql",
    "rls:snapshot": "pnpm rls:snapshot:main && pnpm rls:snapshot:rag",
    "rls:check": "tsx scripts/rls-snapshot-diff.ts",
    "rls:check:main": "tsx scripts/rls-snapshot-diff.ts --target=main",
    "rls:check:rag": "tsx scripts/rls-snapshot-diff.ts --target=rag",
    "rls:coverage": "tsx scripts/rls-coverage-check.ts",
    "slop-check": "tsx scripts/slop-check.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm slop-check",
    "verify:fast": "pnpm typecheck && pnpm lint",
    "test:security": "vitest run tests/security",
    "fixtures:load": "tsx scripts/load-fixtures.ts",
    "fixtures:dry-run": "tsx scripts/load-fixtures.ts --dry-run",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "lint:migrations": "tsx scripts/lint-migrations.ts",
    "knip": "knip",
    "knip:prod": "knip --production",
    "knip:fix": "knip --fix --allow-remove-files",
    "lh:chat": "lighthouse http://localhost:3000/chat --preset=desktop --chrome-flags=\"--headless=new\" --view",
    "lh:home": "lighthouse http://localhost:3000/ --preset=desktop --chrome-flags=\"--headless=new\" --view",
    "lh:ci": "lhci autorun",
    "mutate": "stryker run",
    "mutate:thorough": "stryker run --configFile stryker.thorough.config.json",
    "mutate:abuse": "stryker run --mutate \"apps/main/src/lib/abuse/**/*.ts\"",
    "mutate:audit": "stryker run --mutate \"apps/main/src/lib/audit/**/*.ts\"",
    "mutate:auth": "stryker run --mutate \"apps/main/src/lib/auth/**/*.ts\"",
    "mutate:commissions": "stryker run --mutate \"apps/main/src/lib/commissions/**/*.ts\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@supabase/supabase-js": "^2.106.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.7",
    "inngest": "^4.5.0",
    "knip": "^6.14.2",
    "lighthouse": "^13.3.0",
    "msw": "^2.14.6",
    "postgres": "^3.4.9",
    "semver": "^7.8.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3"
  }
}
