{
  "name": "ai-travel-concierge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "rls:snapshot": "tsx scripts/rls-snapshot.ts > db/rls-snapshot.sql",
    "rls:check": "tsx scripts/rls-snapshot-diff.ts",
    "test:cross-tenant": "vitest run tests/security/cross-tenant-probe",
    "test:contracts": "vitest run tests/contracts",
    "contracts:record": "tsx scripts/record-contracts.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/node": "^25",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10",
    "eslint-config-next": "16.2.6",
    "msw": "^2.14.6",
    "postcss": "^8",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^6",
    "vitest": "^4.1.6"
  }
}
