{
  "name": "atc-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm check:node-runtime && pnpm -r dev",
    "build": "pnpm check:node-runtime && pnpm -r build",
    "lint": "pnpm check:node-runtime && pnpm -r lint",
    "typecheck": "pnpm check:node-runtime && pnpm -r typecheck",
    "test": "pnpm check:node-runtime && vitest run --coverage --passWithNoTests",
    "test:watch": "pnpm check:node-runtime && vitest",
    "test:cross-tenant": "vitest run tests/security/cross-tenant-probe",
    "test:error-injection": "vitest run apps/main/test/error-injection && pnpm --dir apps/rag exec vitest run test/error-injection",
    "test:rag": "pnpm --dir apps/rag test",
    "test:contracts": "vitest run tests/contracts --passWithNoTests",
    "contracts:record": "tsx scripts/record-contracts.ts",
    "rls:snapshot:main": "tsx scripts/rls-snapshot.ts --target=main > db/rls-snapshot-main.sql",
    "rls:snapshot:rag": "tsx scripts/rls-snapshot.ts --target=rag > db/rls-snapshot-rag.sql",
    "rls:snapshot": "pnpm rls:snapshot:main && pnpm rls:snapshot:rag",
    "rls:check": "tsx scripts/rls-snapshot-diff.ts",
    "rls:check:main": "tsx scripts/rls-snapshot-diff.ts --target=main",
    "rls:check:rag": "tsx scripts/rls-snapshot-diff.ts --target=rag",
    "rls:coverage": "tsx scripts/rls-coverage-check.ts",
    "check:tenant-scoped-columns": "tsx scripts/check-tenant-scoped-columns.ts",
    "grants:snapshot:main": "tsx scripts/grants-snapshot.ts --target=main > db/grants-snapshot-main.sql",
    "grants:snapshot:rag": "tsx scripts/grants-snapshot.ts --target=rag > db/grants-snapshot-rag.sql",
    "grants:snapshot": "pnpm grants:snapshot:main && pnpm grants:snapshot:rag",
    "grants:check": "tsx scripts/grants-snapshot-diff.ts",
    "grants:check:main": "tsx scripts/grants-snapshot-diff.ts --target=main",
    "grants:check:rag": "tsx scripts/grants-snapshot-diff.ts --target=rag",
    "slop-check": "tsx scripts/slop-check.ts",
    "check:auth-error": "node scripts/check-auth-error-adoption.mjs",
    "check:dropped-columns": "tsx scripts/check-dropped-column-readers.ts",
    "check:column-readers": "tsx scripts/check-column-readers.ts",
    "check:ambiguous-embeds": "tsx scripts/check-ambiguous-embeds.ts",
    "check:duplication": "jscpd --config .jscpd.json apps/main/src apps/rag/src",
    "check:page-service-role": "node scripts/check-page-service-role.mjs",
    "check:d091": "tsx scripts/check-d091-anti-patterns.ts",
    "check:permission-matrix": "tsx scripts/check-permission-matrix.ts",
    "check:admin-auth": "tsx scripts/check-admin-route-auth.ts",
    "check:error-egress": "tsx scripts/check-error-message-egress.ts",
    "check:unbounded-select": "tsx scripts/check-unbounded-select.ts",
    "check:debug-routes": "tsx scripts/check-debug-routes.ts",
    "check:lifecycle-scripts": "tsx scripts/check-lifecycle-scripts.ts",
    "check:supabase-advisors": "tsx scripts/check-supabase-advisors.ts",
    "scan:bundle-secrets": "tsx scripts/scan-next-bundle-secrets.ts",
    "check:url-validator": "tsx scripts/check-url-validator.ts",
    "check:rate-limit-store": "tsx scripts/check-inmemory-rate-limit.ts",
    "check:webhook-replay": "tsx scripts/check-webhook-replay.ts",
    "check:policy-snapshot": "tsx scripts/check-policy-snapshot.ts",
    "check:server-only": "BLOCKING=1 tsx scripts/check-server-only.ts",
    "check:fetch-waterfalls": "tsx scripts/check-fetch-waterfalls.ts",
    "check:serial-await": "tsx scripts/check-serial-await-in-loop.ts",
    "check:dynamic-rendering": "tsx scripts/check-dynamic-rendering.ts",
    "check:client-data-leak": "tsx scripts/check-client-data-leak.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:schema-drift:main": "tsx scripts/check-schema-drift.ts --target=main",
    "check:schema-drift:rag": "tsx scripts/check-schema-drift.ts --target=rag",
    "check:ledger-objects": "tsx scripts/check-ledger-objects.ts",
    "check:ledger-objects:main": "tsx scripts/check-ledger-objects.ts --target=main",
    "check:ledger-objects:rag": "tsx scripts/check-ledger-objects.ts --target=rag",
    "check:ai-purpose": "tsx scripts/check-ai-purpose-constraint.ts",
    "check:rls-policy-semantics": "tsx scripts/check-rls-policy-semantics.ts",
    "check:extension-manifest": "tsx scripts/check-extension-manifest.ts",
    "check:mocked-tenant-tests": "tsx scripts/check-mocked-tenant-tests.ts",
    "check:app-router-boundaries": "tsx scripts/check-app-router-boundaries.ts",
    "check:pii-columns": "node scripts/check-pii-columns.mjs",
    "check:env-schema": "tsx scripts/check-env-schema-completeness.ts",
    "check:job-service-role-tenant": "tsx scripts/check-job-service-role-tenant.ts",
    "check:migration-collision": "tsx scripts/check-migration-collision.ts",
    "check:memory-decision-collision": "tsx scripts/check-memory-decision-collision.ts",
    "check:node-runtime": "node scripts/check-node-runtime.mjs",
    "check:help-screenshots": "tsx scripts/check-help-screenshots.ts",
    "help:screenshots": "tsx scripts/help-screenshots/capture.ts",
    "verify": "pnpm check:node-runtime && pnpm typecheck && pnpm lint && pnpm lint:migrations && pnpm test && pnpm test:rag && pnpm slop-check && pnpm check:auth-error && pnpm check:dropped-columns && pnpm check:column-readers && pnpm check:ambiguous-embeds && pnpm check:duplication && pnpm check:page-service-role && pnpm check:server-only && pnpm check:d091 && pnpm check:permission-matrix && pnpm check:admin-auth && pnpm check:error-egress && pnpm check:unbounded-select && pnpm check:serial-await && pnpm check:debug-routes && pnpm check:lifecycle-scripts && pnpm check:url-validator && pnpm check:rate-limit-store && pnpm check:webhook-replay && pnpm check:policy-snapshot && pnpm check:ai-purpose && pnpm check:schema-drift && pnpm check:migration-collision && pnpm check:memory-decision-collision && pnpm check:help-screenshots && pnpm check:rls-policy-semantics && pnpm check:extension-manifest && pnpm check:mocked-tenant-tests && pnpm check:app-router-boundaries && pnpm check:pii-columns && pnpm check:env-schema && pnpm check:job-service-role-tenant",
    "verify:fast": "pnpm check:node-runtime && pnpm typecheck && pnpm lint",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "fixtures:load": "tsx scripts/load-fixtures.ts",
    "fixtures:dry-run": "tsx scripts/load-fixtures.ts --dry-run",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:ci": "tsx scripts/ci-reset-test-db.ts",
    "lint:migrations": "tsx scripts/lint-migrations.ts",
    "knip": "knip",
    "knip:prod": "knip --production",
    "knip:fix": "knip --fix --allow-remove-files",
    "lh:chat": "lighthouse http://localhost:3000/chat --preset=desktop --chrome-flags=\"--headless=new\" --view",
    "lh:home": "lighthouse http://localhost:3000/ --preset=desktop --chrome-flags=\"--headless=new\" --view",
    "lh:ci": "lhci autorun",
    "mutate": "stryker run",
    "mutate:thorough": "stryker run stryker.thorough.config.json",
    "mutate:abuse": "stryker run --mutate \"apps/main/src/lib/abuse/**/*.ts\"",
    "mutate:audit": "stryker run --mutate \"apps/main/src/lib/audit/**/*.ts\"",
    "mutate:auth": "stryker run --mutate \"apps/main/src/lib/auth/**/*.ts\"",
    "mutate:commissions": "stryker run --mutate \"apps/main/src/lib/commissions/**/*.ts\"",
    "mutate:rag": "stryker run stryker.rag.config.json"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@supabase/supabase-js": "^2.108.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.8",
    "inngest": "^4.5.1",
    "jsdom": "^29.1.1",
    "jscpd": "^5.0.9",
    "knip": "^6.16.1",
    "lighthouse": "^13.4.0",
    "msw": "^2.14.6",
    "postgres": "^3.4.9",
    "semver": "^7.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0"
  }
}
