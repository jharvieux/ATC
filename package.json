{
  "name": "atc-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "test:cross-tenant": "vitest run tests/security/cross-tenant-probe",
    "test:contracts": "vitest run tests/contracts",
    "contracts:record": "tsx scripts/record-contracts.ts",
    "rls:snapshot": "tsx scripts/rls-snapshot.ts > db/rls-snapshot.sql",
    "rls:check": "tsx scripts/rls-snapshot-diff.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "lint:migrations": "tsx scripts/lint-migrations.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.106.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "msw": "^2.14.6",
    "postgres": "^3.4.9",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
