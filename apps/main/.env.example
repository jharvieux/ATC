# ATC main app — .env.example
#
# Copy to .env.local (gitignored) and fill in real values.
# Schema source of truth: apps/main/src/lib/env.ts (BP29 / spec §28).
# Boot-time validation: apps/main/instrumentation.ts → verifyEnvAtBoot().
#
# Conventions:
#   - NEXT_PUBLIC_* is browser-exposed. NEVER put secrets behind that prefix.
#   - Lines marked "# SECRET" must be stored in your secrets manager, never committed.
#   - Lines marked "# OPERATOR" are operator-set / out-of-band.

# ============================================================================
# §28.1 — Platform identity & routing
# ============================================================================
PLATFORM_PRIMARY_DOMAIN=ai-travelconcierge.com
PLATFORM_DOMAIN_REGEX=^([a-z0-9-]+)\.ai-travelconcierge\.com$
NEXT_PUBLIC_APP_URL=https://ai-travelconcierge.com
NEXT_PUBLIC_PLATFORM_BRAND_NAME=AI Travel Concierge
NEXT_PUBLIC_PLATFORM_SUPPORT_EMAIL=support@ai-travelconcierge.com
NODE_ENV=development
# PLATFORM_ENV: production | staging | preview | development (defaults to development)
PLATFORM_ENV=development
# GIT_COMMIT_SHA is set by Vercel automatically in deployments.
# GIT_COMMIT_SHA=

# ============================================================================
# §28.2 — Supabase (main app)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY  # SECRET
# Optional — present when the app verifies Supabase JWTs directly.
# SUPABASE_JWT_SECRET=REPLACE_WITH_JWT_SECRET  # SECRET
# OPERATOR: direct Postgres connection for migrations. Use the migration-role
# user per §5, not the service-role key.
# SUPABASE_DB_URL=postgres://migrator:PASSWORD@host:5432/postgres  # SECRET

# ============================================================================
# §28.4 — Service-to-service JWT (main signs, RAG verifies)
# NOTE: Spec §28.4 names these INTER_SERVICE_JWT_*; code keeps SERVICE_JWT_*.
# ============================================================================
SERVICE_JWT_PRIVATE_KEY=-----BEGIN_PRIVATE_KEY_PEM-----  # SECRET
SERVICE_JWT_KEY_ID=v1
SERVICE_JWT_TTL_SECONDS=300

# ============================================================================
# §28.5 — Anthropic (Claude API)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_REAL_KEY  # SECRET
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PROMPT_CACHE_ENABLED=true

# Per-feature Haiku model pins (default to claude-haiku-4-5-20251001)
CHAT_HAIKU_MODEL=claude-haiku-4-5-20251001
HAIKU_FORUM_MODERATION_MODEL=claude-haiku-4-5-20251001
ENTITY_EXTRACTION_MODEL=claude-haiku-4-5-20251001
PERSONA_ADDENDUM_HAIKU_MODEL=claude-haiku-4-5-20251001
RAG_INGEST_PII_REDACTION_HAIKU_MODEL=claude-haiku-4-5-20251001
RAG_INGEST_NORMALIZATION_HAIKU_MODEL=claude-haiku-4-5-20251001

# ============================================================================
# §28.6 — OpenAI (DALL-E hero images; embeddings live in RAG service env)
# ============================================================================
# OPENAI_API_KEY=sk-REPLACE_WITH_REAL_KEY  # SECRET

# ============================================================================
# §28.7 — Stripe (Subscriptions + Connect)
# See docs/runbooks/stripe-price-ids.md for the per-environment price-ID convention.
# ============================================================================
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_REAL_KEY  # SECRET (sk_test_ in dev/staging, sk_live_ in prod)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET  # SECRET
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_WITH_CONNECT_WEBHOOK_SECRET  # SECRET
# STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_WITH_CONNECT_CLIENT_ID
# STRIPE_PLATFORM_ACCOUNT_ID=acct_REPLACE_WITH_PLATFORM_ACCOUNT_ID

# Stripe price IDs — obtained from Stripe dashboard per environment.
# Optional at boot; missing price IDs fail at the Stripe call site with a
# clearer error. Naming retains the existing _PROFESSIONAL_/_SEATS_ form;
# spec drift documented in MEMORY D-062.
# STRIPE_PRICE_SUBHOST_STARTER_MONTHLY=price_...
# STRIPE_PRICE_SUBHOST_STARTER_ANNUAL=price_...
# STRIPE_PRICE_SUBHOST_PRO_MONTHLY=price_...
# STRIPE_PRICE_SUBHOST_PRO_ANNUAL=price_...
# STRIPE_PRICE_SUBHOST_AGENCY_MONTHLY=price_...
# STRIPE_PRICE_SUBHOST_AGENCY_ANNUAL=price_...
# STRIPE_PRICE_SUBHOST_AGENCY_SEATS_MONTHLY=price_...
# STRIPE_PRICE_SUBHOST_AGENCY_SEATS_ANNUAL=price_...
# STRIPE_PRICE_BYO_RESEARCH_MONTHLY=price_...
# STRIPE_PRICE_BYO_RESEARCH_ANNUAL=price_...
# STRIPE_PRICE_BYO_PROFESSIONAL_MONTHLY=price_...
# STRIPE_PRICE_BYO_PROFESSIONAL_ANNUAL=price_...
# STRIPE_PRICE_BYO_AGENCY_MONTHLY=price_...
# STRIPE_PRICE_BYO_AGENCY_ANNUAL=price_...
# STRIPE_PRICE_BYO_AGENCY_SEATS_MONTHLY=price_...
# STRIPE_PRICE_BYO_AGENCY_SEATS_ANNUAL=price_...

# ============================================================================
# §28.8 — Resend (email)
# ============================================================================
# RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY  # SECRET (Pattern B default sender)
# RESEND_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET  # SECRET
# RESEND_FROM_DOMAIN=mail.ai-travelconcierge.com
# RESEND_FROM_ADDRESS_DEFAULT=noreply@mail.ai-travelconcierge.com
# RESEND_FROM_NAME_DEFAULT=AI Travel Concierge

# ============================================================================
# §28.9 — OAuth providers (Supabase Auth bridge)
# Microsoft Graph creds are required when OAUTH_MICROSOFT_ENABLED=true.
# ============================================================================
OAUTH_GOOGLE_ENABLED=true
OAUTH_MICROSOFT_ENABLED=true
OAUTH_FACEBOOK_ENABLED=true
OAUTH_APPLE_ENABLED=false  # §17.1 deferred
MICROSOFT_GRAPH_CLIENT_ID=REPLACE_WITH_MS_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=REPLACE_WITH_MS_CLIENT_SECRET  # SECRET
# MICROSOFT_GRAPH_CLIENT_SECRET_PREVIOUS=  # SECRET — during rotation overlap
MICROSOFT_GRAPH_TENANT_ID=common  # tenant GUID to restrict, or 'common' for personal+work

# ============================================================================
# §28.10 — Gmail integration (optional per-tenant)
# ============================================================================
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=  # SECRET
# GMAIL_OAUTH_CLIENT_SECRET_PREVIOUS=  # SECRET — during rotation overlap
# GMAIL_PUBSUB_VERIFICATION_TOKEN=  # SECRET
# GMAIL_PUBSUB_TOPIC=

# ============================================================================
# §28.11 — Inngest (background jobs)
# ============================================================================
INNGEST_SIGNING_KEY=signkey-REPLACE_WITH_REAL_KEY  # SECRET
INNGEST_EVENT_KEY=eventkey-REPLACE_WITH_REAL_KEY  # SECRET
INNGEST_SERVE_PATH=/api/inngest

# ============================================================================
# §28.12 — Image generation
# ============================================================================
IMAGE_GEN_PROVIDER=openai  # 'openai' | 'none'
IMAGE_GEN_RATE_LIMIT_DAILY=20

# ============================================================================
# §28.13 — Application-layer encryption + forensics
# 256-bit keys, base64-encoded. Generate with: openssl rand -base64 32
# Forensics key MUST be distinct from APP_ENCRYPTION_KEY_CURRENT (§26.5a).
# ============================================================================
APP_ENCRYPTION_KEY_CURRENT=REPLACE_WITH_32_BYTE_BASE64_KEY  # SECRET
APP_ENCRYPTION_KEY_ID_CURRENT=v1
# APP_ENCRYPTION_KEY_PREVIOUS=REPLACE_DURING_ROTATION  # SECRET
# APP_ENCRYPTION_KEY_ID_PREVIOUS=v0
# OPERATOR: ISO timestamp of last quarterly backup-verification test (§13.5.3).
# APP_ENCRYPTION_BACKUP_VERIFIED_AT=2026-01-15T00:00:00Z

FORENSICS_ENCRYPTION_KEY_CURRENT=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY  # SECRET
FORENSICS_ENCRYPTION_KEY_ID_CURRENT=forensics-v1
# Forensics keys use a two-step grace window (_PRIOR_1 / _PRIOR_2). Spec
# §28.13 lists only _PREVIOUS — operator deviation, MEMORY D-062.
# FORENSICS_ENCRYPTION_KEY_PRIOR_1=  # SECRET
# FORENSICS_ENCRYPTION_KEY_ID_PRIOR_1=
# FORENSICS_ENCRYPTION_KEY_PRIOR_2=  # SECRET
# FORENSICS_ENCRYPTION_KEY_ID_PRIOR_2=

# ============================================================================
# §28.14 — Audit & observability
# ============================================================================
# SENTRY_DSN=https://REPLACE_WITH_DSN@sentry.io/PROJECT_ID  # SECRET
# SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
AUDIT_LOG_RETENTION_YEARS=7
# §26.6 — Operator alert email recipient. When set + RESEND_API_KEY is
# configured, sendOperatorAlert delivers via Resend; otherwise alerts
# still land in audit_log and Vercel runtime logs.
# OPERATOR_ALERT_EMAIL=ops@example.com

# ============================================================================
# §28.15 — Feature flags & operational toggles
# ============================================================================
AI_GLOBAL_KILL_SWITCH=false   # §10.6 emergency stop
RAG_INGESTION_PAUSED=false
MAINTENANCE_MODE=false
SIGNUP_ENABLED=true
STRIPE_CONNECT_ONBOARDING_ENABLED=true

# ============================================================================
# §28.16 — Tone & persona configuration
# ============================================================================
PERSONA_TONE_DEFAULT_MAX_LEVEL=3
PERSONA_ADDENDUM_HAIKU_SCREEN_ENABLED=true
SUPERVISOR_REGEN_MAX_PER_CONVERSATION=6
SUPERVISOR_REGEN_MAX_TOKENS_PER_CONVERSATION=25000
MEMORY_EXTRACTION_DEBOUNCE_SECONDS=120
MEMORY_EXTRACTION_MESSAGE_WINDOW=50
MEMORY_EXTRACTION_RETRY_DELAY_MS=5000
# §11.5 — DOB re-prompt cadence (D-087: tightened from 365d to 30d).
DOB_REPROMPT_INTERVAL_DAYS=30
# §11.5 — Suppress re-prompt for users with a booking sailing within this window.
DOB_IMMINENT_BOOKING_WINDOW_DAYS=60

# ============================================================================
# §28.17 — Abuse monitoring thresholds (most are code constants per tier)
# ============================================================================
# AI-cost soft1/2/hard thresholds, RAG approaching threshold, email bounce
# threshold — all percentages of the per-tier base.
ABUSE_AI_COST_SOFT1_PERCENT=30
ABUSE_AI_COST_SOFT2_PERCENT=50
ABUSE_AI_COST_HARD_PERCENT=70
ABUSE_RAG_APPROACHING_PERCENT=85
ABUSE_EMAIL_BOUNCE_RATE_THRESHOLD_PERCENT=5
ABUSE_OVERRIDE_REQUIRE_REAUTH=true
ABUSE_RAG_PROMOTION_BONUS_PER_CHUNK=25
ABUSE_RECOMPUTE_CRON_SCHEDULE=0 3 * * *
ABUSE_OVERRIDE_DEFAULT_DURATION_DAYS=30
ABUSE_TENANT_USAGE_REFRESH_SECONDS=60

# ============================================================================
# §32.14 — GitHub App for Self-Service Help (BP31)
# Provisioned per Part 9 prerequisites with Issues (R/W) permission only.
# The App authenticates the platform to GitHub for issue creation —
# PRs are NOT created by the App; operator uses their own `gh` session.
# ============================================================================
GITHUB_APP_ID=111111
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PEM_BODY\n-----END PRIVATE KEY-----"  # SECRET
GITHUB_APP_INSTALLATION_ID=222222
GITHUB_REPO_OWNER=jharvieux
GITHUB_REPO_NAME=ATC
HELP_DOCS_CACHE_TTL_SECONDS=3600
# BP32 §32.14 — Phase 2 customer bug flow (ship dark by default).
PHASE_2_CUSTOMER_BUG_FLOW_ENABLED=false
CUSTOMER_BUG_PER_DAY_LIMIT=5
# Webhook secret for the GitHub `issues.closed` handler. Required when
# Phase 2 is enabled; route 401s without it.
# GITHUB_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET  # SECRET

# ============================================================================
# §27.12 — vendor pricing cache (NOT pricing values — those live in DB)
# ============================================================================
ANTHROPIC_DAILY_PRICING_CACHE_TTL_HOURS=24
OPENAI_DAILY_PRICING_CACHE_TTL_HOURS=24

# ============================================================================
# §13.6 — host-adapter fallback email (§13.6)
# ============================================================================
# HOST_ADAPTER_FALLBACK_EMAIL_TO=ops@your-host.example
# HOST_ADAPTER_FALLBACK_EMAIL_FROM=noreply@your-host.example

# ============================================================================
# §16 — white-label deployment infrastructure
# ============================================================================
# VERCEL_API_TOKEN=  # SECRET — used by custom-domain claim flow
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# PLATFORM_PARENT_DOMAIN=tenants.ai-travelconcierge.com
RESERVED_PARENT_DOMAIN=tenants.ai-travelconcierge.com
DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query

# ============================================================================
# §18 — group bookings — token signing
# ============================================================================
INVITATION_TOKEN_HMAC_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY  # SECRET — generate: openssl rand -base64 32
# COMPANION_TOKEN_HMAC_KEY=  # SECRET — falls back to INVITATION_TOKEN_HMAC_KEY (see MEMORY D-056)

# ============================================================================
# §19.3 — forum moderation
# ============================================================================
FORUM_MODERATION_HAIKU_TIMEOUT_MS=2000
FORUM_MODERATION_RETRY_TIMEOUT_HOURS=24

# ============================================================================
# §21 — RAG consumer & hallucination defense
# ============================================================================
RAG_CHUNK_CONFIDENCE_FLOOR=0.35
RAG_CHUNK_DEDUP_SIMILARITY_THRESHOLD=0.8
RAG_CHUNK_TOP_N_DEFAULT=4
QUOTE_PDF_RENDERER=react-pdf  # 'puppeteer' | 'react-pdf'
QUOTE_ESTIMATE_VALIDITY_DAYS=7
QUOTE_DEFAULT_VARIANCE_CENTS=5000

# ============================================================================
# §22 — RAG ingestion
# ============================================================================
RAG_INGEST_GLOBAL_RELEVANCE_AUTOFLAG_THRESHOLD=0.6
RAG_INGEST_AGGREGATION_WINDOW_HOURS=24
RAG_INGEST_RECURRING_PATTERN_DAYS=3
RAG_INGEST_MAX_FILE_SIZE_BYTES=52428800
RAG_INGEST_OCR_PROVIDER=none  # 'tesseract' | 'gcv' | 'none'
# GCV_API_KEY=  # SECRET — required only if RAG_INGEST_OCR_PROVIDER='gcv'

# ============================================================================
# §23 — Email & notifications — pre-cruise timing
# ============================================================================
PRECRUISE_T90_HOURS_BEFORE=2160
PRECRUISE_T30_HOURS_BEFORE=720
PRECRUISE_T7_HOURS_BEFORE=168
PRECRUISE_T1_HOURS_BEFORE=24

# ============================================================================
# §8.7 — RAG service sync — inbound to main
# ============================================================================
RAG_SERVICE_URL=https://rag.ai-travelconcierge.com
RAG_WEBHOOK_SECRET=REPLACE_WITH_RAG_WEBHOOK_SECRET  # SECRET

# ============================================================================
# §24 — Chat limits
# ============================================================================
# Anonymous (§24.8) — normal + under-abuse caps
ANON_CHAT_LIMIT_PER_SESSION=5
ANON_CHAT_LIMIT_PER_IP_24H=15
ANON_CHAT_LIMIT_PER_FINGERPRINT_24H=10
ANON_CHAT_LIMIT_PER_SESSION_UNDER_ABUSE=2
ANON_CHAT_LIMIT_PER_IP_UNDER_ABUSE=5
ANON_CHAT_LIMIT_PER_FINGERPRINT_UNDER_ABUSE=3
# Authenticated customer chat (§24.9)
CUSTOMER_CHAT_SOFT1_CAP=20
CUSTOMER_CHAT_SOFT2_CAP=30
CUSTOMER_CHAT_HARD_CAP=40
CUSTOMER_CHAT_BOOKING_BONUS_PERCENT=100
CUSTOMER_CHAT_LIMIT_HARD_CEILING=200
CUSTOMER_CHAT_LIMIT_HARD_FLOOR=15
CUSTOMER_CHAT_WINDOW_DAYS=30
CUSTOMER_CHAT_SOFT1_COOLDOWN_DAYS=7
CUSTOMER_CHAT_SOFT2_COOLDOWN_DAYS=3

# ============================================================================
# §25 — Retention & forensics
# ============================================================================
# PLATFORM_PEPPER: SET ONCE AT PLATFORM GENESIS. NEVER ROTATE — rotation
# breaks every existing customer hash on bookings/commissions/contacts.
PLATFORM_PEPPER=REPLACE_WITH_GENESIS_PEPPER_AND_NEVER_CHANGE  # SECRET

# §25.10 — staging outbound isolation
STAGING_MODE=false
# TEST_OVERRIDE_EMAIL=ops+staging@example.com
# TEST_OVERRIDE_PHONE=+15555550199

# ============================================================================
# §33.10 — Apify pricing integration (BP34) + CruiseMapper DIY (BP36) — DEFAULT-OFF.
# Operator flips *_ENABLED=true to activate spend. Without both the API
# token AND the ENABLED flag, no external call fires.
# ============================================================================
# APIFY_API_TOKEN=apify_api_REPLACE_ME  # SECRET
APIFY_ADAPTER_ENABLED=false
APIFY_RUN_BUDGET_USD_CEILING=50
APIFY_MONTHLY_BUDGET_USD_CEILING=500
# §33.9.3 — General-pricing pause-priority sub-cap as a percent of the
# monthly cap. General-pricing refresh (CruiseMapper itineraries) pauses
# at this fraction; tracked-sailings (price-watch) runs until the full
# cap. Default 80 → general pauses at 80%, watches keep going to 100%.
APIFY_GENERAL_PRICING_BUDGET_PCT=80
PRICE_FRESHNESS_FRESH_HOURS=72
PRICE_FRESHNESS_EXPIRED_HOURS=744
# BP35 §33.4 — CruiseMapper itinerary monthly ingest. Default-OFF: even
# with APIFY_ADAPTER_ENABLED=true, this flag is the additional opt-in
# that authorizes the itinerary actor dispatch + OpenAI embedding spend.
CRUISEMAPPER_ITINERARY_INGEST_ENABLED=false
CRUISEMAPPER_ITINERARY_ACTOR_ID=crawlerbros/cruisemapper-cruises-scraper
# BP36 §33.5 — CruiseMapper DIY (text-only) scraper. Default-OFF.
# CRUISEMAPPER_DIY_USER_AGENT MUST identify the platform with a real ops
# contact email so CruiseMapper can reach us before blocking. Example:
#   AITravelConcierge/1.0 (+ops@ai-travelconcierge.com)
# CRUISEMAPPER_DIY_USER_AGENT=AITravelConcierge/1.0 (+ops@ai-travelconcierge.com)
CRUISEMAPPER_DIY_INGEST_ENABLED=false
CRUISEMAPPER_DIY_RATE_LIMIT_RPS=1.0
CRUISEMAPPER_DIY_BASE_URL=https://www.cruisemapper.com
# BP40 §33.8 — price-watch subscriptions. Default-OFF cost-deferral:
# the daily Inngest job runs (updates statuses) but suppresses
# subscriber notifications when false. Flip to true to enable email
# / in-app notifications on triggered watches.
PRICE_WATCH_NOTIFICATIONS_ENABLED=false
