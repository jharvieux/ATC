# ATC RAG service — .env.example
#
# Copy to .env.local (gitignored) and fill in real values.
# Schema source of truth: apps/rag/src/lib/env.ts (BP29 / spec §28).
# Boot-time validation: apps/rag/instrumentation.ts → verifyEnvAtBoot().

# ============================================================================
# §28.1 — Platform identity
# ============================================================================
PLATFORM_PRIMARY_DOMAIN=ai-travelconcierge.com
NODE_ENV=development
# VERCEL_ENV is auto-set by Vercel deployments.
# VERCEL_ENV=

# ============================================================================
# §28.3 — Supabase (RAG service)
# Spec §28.3 names these RAG_SUPABASE_*; code keeps SUPABASE_RAG_* prefix
# so all Supabase-prefixed vars co-locate in the shared .env.local.
# ============================================================================
SUPABASE_RAG_URL=https://your-rag-project.supabase.co
SUPABASE_RAG_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_RAG_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY  # SECRET
# OPERATOR: direct Postgres connection for RAG migrations.
# RAG_SUPABASE_DB_URL=postgres://migrator:PASSWORD@host:5432/postgres  # SECRET

# ============================================================================
# §28.6 — OpenAI embeddings
# ============================================================================
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_KEY  # SECRET
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536  # MUST be 1536 per §6

# ============================================================================
# §28.4 — Service-to-service JWT verification (RAG verifies main's tokens)
# NOTE: Spec names these INTER_SERVICE_JWT_*; code keeps SERVICE_JWT_*.
# ============================================================================
SERVICE_JWT_PUBLIC_KEY=-----BEGIN_PUBLIC_KEY_PEM-----
SERVICE_JWT_KEY_ID_CURRENT=v1
# Optional during rotation overlap — previous public key + its kid. Both must
# be set together (env validation enforces this). Both kids must appear in
# SERVICE_JWT_ACCEPTED_KEY_IDS below.
# SERVICE_JWT_PUBLIC_KEY_PREVIOUS=-----BEGIN_PUBLIC_KEY_PEM-----
# SERVICE_JWT_KEY_ID_PREVIOUS=v0
SERVICE_JWT_ACCEPTED_KEY_IDS=v1

# §28.4 — jti replay cache (§8.3 fail-closed contract)
REDIS_URL=redis://localhost:6379

# ============================================================================
# §8.3 — nightly reconcile callback to main app
# ============================================================================
MAIN_APP_URL=https://ai-travelconcierge.com
# #2002 / D-091 #28 rotation set — set _CURRENT (preferred) or the legacy var.
MAIN_APP_ADMIN_API_KEY=REPLACE_WITH_ADMIN_API_KEY  # SECRET
# MAIN_APP_ADMIN_API_KEY_CURRENT=REPLACE_WITH_ADMIN_API_KEY  # SECRET

# ============================================================================
# §8.7 — inbound tenant-events webhook from main
# ============================================================================
# #2004 / D-091 #28 rotation set — verify sites accept _CURRENT/_PREVIOUS
# plus the legacy var. Set at least one of _CURRENT/legacy.
RAG_WEBHOOK_SECRET=REPLACE_WITH_RAG_WEBHOOK_SECRET  # SECRET
# RAG_WEBHOOK_SECRET_CURRENT=REPLACE_WITH_RAG_WEBHOOK_SECRET  # SECRET
# RAG_WEBHOOK_SECRET_PREVIOUS=  # SECRET — only during rotation overlap

# ============================================================================
# §28.14 — Audit & observability
# ============================================================================
# SENTRY_DSN=https://REPLACE_WITH_DSN@sentry.io/PROJECT_ID  # SECRET
# SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
