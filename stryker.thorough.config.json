{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Thorough variant of stryker.config.json — uses coverageAnalysis: 'all' so module-load-time constants (e.g. permission-grants.ts grant-key Sets) are exercised by every test, not just tests Stryker thinks cover them. Slower (~3-5x wall time vs perTest) but accurate. Run via `pnpm mutate:thorough` or `pnpm mutate:thorough -- --mutate path/to/file.ts`.",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "coverageAnalysis": "all",
  "ignoreStatic": false,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "disableTypeChecks": "{apps,packages,tests}/**/*.{ts,tsx}",
  "mutate": [
    "apps/main/src/lib/**/*.ts",
    "apps/main/src/inngest/**/*.ts",
    "apps/main/src/app/api/**/route.ts",
    "apps/main/src/proxy.ts",
    "apps/rag/src/lib/**/*.ts",
    "apps/rag/src/app/api/**/route.ts",
    "apps/rag/src/middleware.ts",
    "packages/shared-types/src/**/*.ts",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/__tests__/**",
    "!**/types.ts",
    "!**/*.d.ts",
    "!apps/main/src/lib/env.ts",
    "!apps/rag/src/lib/env.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "logLevel": "info"
}
