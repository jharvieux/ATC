+// F-ssrf-01 — shared SSRF guard for admin-supplied outbound URLs.
+// Layers: (1) validateUrlStatic — scheme allowlist (http/https) + block
+// loopback/link-local(169.254/16 incl. IMDS)/RFC1918/CGNAT/reserved + IPv6
+// loopback/link-local/ULA/v4-mapped + localhost/*.internal/*.local +
+// decimal/hex IP literals; (2) validateUrlResolved — static + DNS-resolve and
+// reject if any resolved addr is private; (3) fetchGuarded — redirect:'manual'
+// with per-hop re-validation (bounded to 5 hops). Fails closed throughout.
+import { isIP } from "node:net";
+import { lookup } from "node:dns/promises";
+const ALLOWED_SCHEMES = new Set(["https:", "http:"]);
+const BLOCKED_HOST_SUFFIXES = [".internal", ".local", ".localhost"];
+const BLOCKED_HOSTNAMES = new Set(["localhost"]);
+export interface SsrfCheck { allowed: boolean; reason?: string }
+// ... ipv4ToInt / isBlockedIpv4 (0/8,10/8,127/8,100.64/10,169.254/16,172.16/12,
+//     192.168/16,224/4,240/4) / isBlockedIpv6 (::1,::,fe80,fc,fd,::ffff:v4) ...
+export function validateUrlStatic(url: string): SsrfCheck { /* scheme + host/IP checks */ }
+export async function validateUrlResolved(url: string): Promise<SsrfCheck> { /* static + DNS */ }
+export async function fetchGuarded(url: string, init): Promise<Response> { /* manual redirects + per-hop revalidation */ }

