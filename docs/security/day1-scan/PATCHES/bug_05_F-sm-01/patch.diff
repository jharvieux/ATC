diff --git a/apps/main/supabase/migrations/20260701000000_customer_chat_atomic_increment.sql b/apps/main/supabase/migrations/20260701000000_customer_chat_atomic_increment.sql
new file mode 100644
--- /dev/null
+++ b/apps/main/supabase/migrations/20260701000000_customer_chat_atomic_increment.sql
@@
+-- F-sm-01 — atomic increment RPC for customer_chat_counters (replaces the
+-- read-modify-write TOCTOU in lib/chat/customer-limit.ts:enforceCustomerLimit).
+CREATE OR REPLACE FUNCTION public.increment_customer_chat_count(
+  p_user_id UUID, p_tenant_id UUID, p_seed INTEGER,
+  p_window_start TIMESTAMPTZ, p_now TIMESTAMPTZ)
+RETURNS INTEGER LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+DECLARE v_count INTEGER;
+BEGIN
+  INSERT INTO public.customer_chat_counters (user_id, tenant_id, current_count, last_message_at)
+  VALUES (p_user_id, p_tenant_id, GREATEST(p_seed,0)+1, p_now)
+  ON CONFLICT (user_id, tenant_id) DO UPDATE
+    SET current_count = CASE
+          WHEN public.customer_chat_counters.last_message_at IS NULL
+            OR public.customer_chat_counters.last_message_at < p_window_start
+          THEN GREATEST(p_seed,0)+1
+          ELSE public.customer_chat_counters.current_count + 1 END,
+        last_message_at = p_now
+  RETURNING current_count INTO v_count;
+  RETURN v_count;
+END; $$;
+-- + reset_customer_chat_count(...) refund helper (clamp back to hard_cap)
+REVOKE EXECUTE ON FUNCTION public.increment_customer_chat_count(UUID,UUID,INTEGER,TIMESTAMPTZ,TIMESTAMPTZ) FROM PUBLIC;
+GRANT  EXECUTE ON FUNCTION public.increment_customer_chat_count(UUID,UUID,INTEGER,TIMESTAMPTZ,TIMESTAMPTZ) TO service_role;

