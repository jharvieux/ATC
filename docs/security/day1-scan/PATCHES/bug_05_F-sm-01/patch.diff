+  );
@@
   if (nextCount > resolved.hard_cap) {
-    // ... upsertCounter({ current_count: counter.current_count, ... })
-    return { tier: "hard", ..., current_count: counter.current_count, ... };
+    // Refund: clamp back to hard_cap (the blocked request delivered no AI
+    // response). Convergent — concurrent racers all clamp to hard_cap.
+    await upsertCounter(db, args.user_id, args.tenant_id, { current_count: resolved.hard_cap, hard_limit_hit_at: now, ... });
+    return { tier: "hard", resolved, current_count: resolved.hard_cap, reset_at: oldestSince };
   }
   // Non-hard: RPC already committed the increment; upsert only persists the
   // resolved-caps snapshot + last_message_at (no count math).
-  await upsertCounter(db, ..., { current_count: nextCount, ... });
+  await upsertCounter(db, ..., { last_message_at: now, ... });

