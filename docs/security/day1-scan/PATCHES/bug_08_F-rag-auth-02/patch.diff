# Adds the missing `scope==='write'` guard (matching replace-chunk / media-
# assets/upsert) to the 5 destructive admin routes that gated on
# service_identifier only.

--- a/apps/rag/src/app/api/admin/purge-tenant-scoped-chunks/route.ts
+++ b/apps/rag/src/app/api/admin/purge-tenant-scoped-chunks/route.ts
@@ export const POST = withServiceAuth(async (req, ctx) => {
+  if (ctx.scope !== "write") {
+    return Response.json({ error: "insufficient_scope" }, { status: 403 });
+  }

