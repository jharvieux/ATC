diff --git a/apps/main/src/lib/chat/public-token-resolver.ts b/apps/main/src/lib/chat/public-token-resolver.ts
--- a/apps/main/src/lib/chat/public-token-resolver.ts
+++ b/apps/main/src/lib/chat/public-token-resolver.ts
@@ -45,3 +45,21 @@ export async function resolvePublicToken(

   return null;
 }
+
+// §38.8.1 / §39.5 — A resolved token alone is not enough to load customer
+// PII into an LLM conversation: the resource must also be in a
+// customer-viewable state. Mirrors the allowlist enforced by the sibling
+// quote-select route (apps/.../public/quote/[token]/select/route.ts), which
+// permits only 'sent'/'viewed' quotes — that allowlist already excludes
+// 'expired' (the status an out-of-date quote carries), so a separate
+// valid_until comparison would be redundant with the established gate.
+// Itineraries are 'draft' | 'sent' | 'archived'; the public itinerary page
+// already hides 'draft', and 'archived' is a past trip, so only 'sent' loads.
+export function isPublicTokenViewable(resolved: ResolvedPublicToken): boolean {
+  if (resolved.kind === "quote") {
+    return resolved.status === "sent" || resolved.status === "viewed";
+  }
+  return resolved.status === "sent";
+}
