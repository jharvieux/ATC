+  // 410 Gone, not 404 — the token is real but the resource is no longer active.
+  if (!isPublicTokenViewable(resolved)) {
+    return Response.json({ error: "resource_unavailable" }, { status: 410 });
+  }

   const rl = checkRateLimit(token);

